# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (contains API keys - NEVER commit)
local.properties

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Keystore files (NEVER commit)
*.jks
*.keystore

# Google Services (contains API keys - NEVER commit)
google-services.json

# Log files
*.log

# OS-specific files
.DS_Store
Thumbs.db

# API Keys and secrets (NEVER commit)
*.env
.env.local
.env.production
secrets.properties
apikeys.properties

# Android build artifacts
*.hprof
*.traces

# Gradle wrapper JAR
!gradle/wrapper/gradle-wrapper.jar

# Proguard
proguard/